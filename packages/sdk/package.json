{
  "name": "@board/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/project.ts",
    "./frame": "./src/frame.tsx",
    "./vite": "./src/vite.ts",
    "./source": "./src/source.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/project.d.ts",
        "default": "./dist/project.js"
      },
      "./frame": {
        "types": "./dist/frame.d.ts",
        "default": "./dist/frame.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./source": {
        "types": "./dist/source.d.ts",
        "default": "./dist/source.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --test 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "magic-string": "1.4.2"
  },
  "peerDependencies": {
    "msw": "^2.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": ">=7"
  },
  "devDependencies": {
    "msw": "2.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.2"
  }
}
